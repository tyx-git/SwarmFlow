{
  // TUI（external/opentui）的独立类型检查配置。
  //
  // 为什么不并入根 tsconfig：
  //   * 根配置只覆盖 src/**（Node 侧），TUI 是终端侧的 JSX 代码，依赖面不同
  //     （@opentui/react 的 jsxImportSource、fork 镜像的 ambient 声明等）
  //   * 两边混在一个配置里，src 侧的报错会被 TUI 的噪声淹没
  //
  // 本配置刻意只排除“运行时不会被加载”的部分，其余一律检查 —— 因此剩下的报错都是真问题。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // TUI 只跑在 Node 上（tsx 开发态与打包后的 SEA exe）。
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "external/opentui/**/*.ts",
    "external/opentui/**/*.tsx",
    // 应用侧的 ambient 声明（例如 @joplin/turndown-plugin-gfm），否则会被误报 TS7016
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "release",
    // 上游自带的测试/基准/测试辅助：不属于应用运行图
    // （2026-10-14 已从仓库删除 core/{tests,benchmark,testing} 与全部 *.test.ts，
    //   以下模式保留是为了防止将来重新引入同类文件时污染检查）
    "**/*.test.ts",
    "**/__tests__/**",
    "**/*.node-test.ts"
  ]
}
