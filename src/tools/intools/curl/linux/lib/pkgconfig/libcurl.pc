prefix=/data/curl-x86_64
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT MQTTS POP3 POP3S RTSP SCP SFTP SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc asyn-rr AsynchDNS brotli ECH HSTS HTTP2 HTTP3 HTTPS-proxy HTTPSRR IDN IPv6 Largefile libz PSL SSL SSLS-EXPORT threadsafe TLS-SRP UnixSockets zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.20.0
Requires: libidn2,zlib,libbrotlidec,libbrotlicommon,libzstd,openssl,libpsl,libssh2,libnghttp2,libngtcp2,libngtcp2_crypto_ossl,libnghttp3,libcares
Requires.private: libidn2,zlib,libbrotlidec,libbrotlicommon,libzstd,openssl,libpsl,libssh2,libnghttp2,libngtcp2,libngtcp2_crypto_ossl,libnghttp3,libcares
Libs: -L${libdir} -lcurl -lcares -lpthread  -lnghttp3  -lngtcp2_crypto_ossl -lngtcp2 -lssl -ldl -lcrypto -ldl  -lngtcp2  -lnghttp2  -lidn2 -lunistring -lpthread  -lssh2 -lssh2 -lssl -lcrypto -lz -lssl -lcrypto -ldl -lz -lcrypto -ldl -lz  -lpsl  -lssl -lcrypto -lssl -ldl -pthread -lcrypto -ldl -pthread  -lzstd -lzstd  -lbrotlidec -lbrotlidec -lbrotlicommon -lm  -lbrotlicommon -lm  -lz  
Libs.private: -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -lcares -lpthread -lnghttp3 -lngtcp2_crypto_ossl -lngtcp2 -lssl -ldl -lcrypto -ldl -lngtcp2 -lnghttp2 -lidn2 -lunistring -lpthread -lssh2 -lssh2 -lssl -lcrypto -lz -lssl -lcrypto -ldl -lz -lcrypto -ldl -lz -lpsl -lssl -lcrypto -lssl -ldl -pthread -lcrypto -ldl -pthread -lzstd -lzstd -lbrotlidec -lbrotlidec -lbrotlicommon -lm -lbrotlicommon -lm -lz
Cflags: -I${includedir} -DCURL_STATICLIB
Cflags.private: -DCURL_STATICLIB
