# shellcheck disable=SC2006

prefix='/data/curl-x86_64'
# Used in 'libdir'
# shellcheck disable=SC2034
exec_prefix="${prefix}"
# shellcheck disable=SC2034
includedir="${prefix}/include"

usage()
{
  cat <<EOF
Usage: curl-config [OPTION]

Available values for OPTION include:

  --built-shared        says 'yes' if libcurl was built shared
  --ca                  CA bundle install path
  --cc                  compiler
  --cflags              preprocessor and compiler flags
  --checkfor [version]  check for (lib)curl of the specified version
  --configure           the arguments given to configure when building curl
  --features            newline separated list of enabled features
  --help                display this help and exit
  --libs                library linking information
  --prefix              curl install prefix
  --protocols           newline separated list of enabled protocols
  --ssl-backends        output the SSL backends libcurl was built to support
  --static-libs         static libcurl library linking information
  --version             output version information
  --vernum              output version as a hexadecimal number
EOF

  exit "$1"
}

if test "$#" -eq 0; then
  usage 1
fi

while test "$#" -gt 0; do
  case "$1" in
  --built-shared)
    echo 'no'
    ;;

  --ca)
    echo '/etc/ssl/certs/ca-certificates.crt'
    ;;

  --cc)
    echo '/data/x86_64-linux-musl/bin/x86_64-linux-musl-cc'
    ;;

  --prefix)
    echo "$prefix"
    ;;

  --feature|--features)
    for feature in alt-svc asyn-rr AsynchDNS brotli ECH HSTS HTTP2 HTTP3 HTTPS-proxy HTTPSRR IDN IPv6 Largefile libz PSL SSL SSLS-EXPORT threadsafe TLS-SRP UnixSockets zstd ''; do
      test -n "$feature" && echo "$feature"
    done
    ;;

  --protocols)
    # shellcheck disable=SC2043
    for protocol in DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT MQTTS POP3 POP3S RTSP SCP SFTP SMTP SMTPS TELNET TFTP WS WSS; do
      echo "$protocol"
    done
    ;;

  --version)
    echo 'libcurl 8.20.0'
    exit 0
    ;;

  --checkfor)
    checkfor="$2"
    cmajor=`echo "$checkfor" | cut -d. -f1`
    cminor=`echo "$checkfor" | cut -d. -f2`
    # when extracting the patch part we strip off everything after a
    # dash as that's used for things like version 1.2.3-pre1
    cpatch=`echo "$checkfor" | cut -d. -f3 | cut -d- -f1`

    vmajor=`echo '8.20.0' | cut -d. -f1`
    vminor=`echo '8.20.0' | cut -d. -f2`
    # when extracting the patch part we strip off everything after a
    # dash as that's used for things like version 1.2.3-pre1
    vpatch=`echo '8.20.0' | cut -d. -f3 | cut -d- -f1`

    if test "$vmajor" -gt "$cmajor"; then
      exit 0
    fi
    if test "$vmajor" -eq "$cmajor"; then
      if test "$vminor" -gt "$cminor"; then
        exit 0
      fi
      if test "$vminor" -eq "$cminor"; then
        if test "$cpatch" -le "$vpatch"; then
          exit 0
        fi
      fi
    fi

    echo "requested version $checkfor is newer than existing 8.20.0"
    exit 1
    ;;

  --vernum)
    echo '081400'
    exit 0
    ;;

  --help)
    usage 0
    ;;

  --cflags)
    if test "${prefix}/include" = '/usr/include'; then
      echo '-DCURL_STATICLIB'
    else
      echo "-DCURL_STATICLIB -I${prefix}/include"
    fi
    ;;

  --libs)
    if test "${exec_prefix}/lib" != '/usr/lib' && test "${exec_prefix}/lib" != '/usr/lib64'; then
      curllibdir="-L${exec_prefix}/lib "
    else
      curllibdir=''
    fi
    if test 'no' = 'no'; then
      echo "${curllibdir}-lcurl -lcares -lpthread -lnghttp3 -lngtcp2_crypto_ossl -lngtcp2 -lssl -ldl -lcrypto -ldl -lngtcp2 -lnghttp2 -lidn2 -lunistring -lpthread -lssh2 -lssh2 -lssl -lcrypto -lz -lssl -lcrypto -ldl -lz -lcrypto -ldl -lz -lpsl -lssl -lcrypto -lssl -ldl -pthread -lcrypto -ldl -pthread -lzstd -lzstd -lbrotlidec -lbrotlidec -lbrotlicommon -lm -lbrotlicommon -lm -lz"
    else
      echo "${curllibdir}-lcurl"
    fi
    ;;

  --ssl-backends)
    echo 'OpenSSL'
    ;;

  --static-libs)
    if test 'yes' != 'no'; then
      echo "${exec_prefix}/lib/libcurl.a -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib64 -L/data/curl-x86_64/lib -L/data/curl-x86_64/lib -lcares -lpthread -lnghttp3 -lngtcp2_crypto_ossl -lngtcp2 -lssl -ldl -lcrypto -ldl -lngtcp2 -lnghttp2 -lidn2 -lunistring -lpthread -lssh2 -lssh2 -lssl -lcrypto -lz -lssl -lcrypto -ldl -lz -lcrypto -ldl -lz -lpsl -lssl -lcrypto -lssl -ldl -pthread -lcrypto -ldl -pthread -lzstd -lzstd -lbrotlidec -lbrotlidec -lbrotlicommon -lm -lbrotlicommon -lm -lz"
    else
      echo 'curl was built with static libraries disabled' >&2
      exit 1
    fi
    ;;

  --configure)
    echo " '--host=x86_64-pc-linux-gnu' '--prefix=/data/curl-x86_64' '--enable-static' '--disable-shared' '--with-openssl' '--with-brotli' '--with-zstd' '--with-nghttp2' '--with-nghttp3' '--with-ngtcp2' '--with-libidn2' '--with-libssh2' '--enable-ech' '' '--enable-hsts' '--enable-mime' '--enable-cookies' '--enable-http-auth' '--enable-manual' '--enable-proxy' '--enable-file' '--enable-http' '--enable-ftp' '--enable-telnet' '--enable-tftp' '--enable-pop3' '--enable-imap' '--enable-smtp' '--enable-gopher' '--enable-mqtt' '--enable-doh' '--enable-dateparse' '--enable-verbose' '--enable-alt-svc' '--enable-websockets' '--enable-ipv6' '--enable-unix-sockets' '--enable-socketpair' '--enable-headers-api' '--enable-versioned-symbols' '--enable-threaded-resolver' '--enable-optimize' '--enable-warnings' '--enable-dict' '--enable-netrc' '--enable-bearer-auth' '--enable-tls-srp' '--enable-dnsshuffle' '--enable-get-easy-options' '--enable-progress-meter' '--with-ca-bundle=/etc/ssl/certs/ca-certificates.crt' '--with-ca-path=/etc/ssl/certs' '--with-ca-fallback' '--enable-ares' '--enable-httpsrr' '--enable-ipfs' '--disable-ldap' '--disable-ldaps' '--enable-ssls-export' '' 'build_alias=' 'host_alias=x86_64-pc-linux-gnu' 'target_alias=' 'CC=/data/x86_64-linux-musl/bin/x86_64-linux-musl-cc' 'CFLAGS=-O3 -Wno-error=unknown-pragmas -Wno-error=sign-compare -Wno-error=cast-align -Wno-maybe-uninitialized -Wno-error=null-dereference -Wno-error=discarded-qualifiers -Wno-error=cast-qual' 'LDFLAGS=-L/data/curl-x86_64/lib -L/data/curl-x86_64/lib64'"
    ;;

  *)
    echo "unknown option: $1"
    usage 1
    ;;
  esac
  shift
done

exit 0
